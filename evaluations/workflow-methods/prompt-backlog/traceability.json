{
  "schema_version": 1,
  "scope": [
    "PRD C: Prompt editing",
    "PRD D: Backlog reconciliation"
  ],
  "model_evaluation": "not_performed",
  "requirements": [
    {
      "id": "C-selection",
      "requirement": "Behavioral prompt change, not invented pipeline or unauthorized model access",
      "disposition": "retained",
      "references": [
        "develop/prompt.md"
      ],
      "worked": "develop/prompt-worked.md",
      "tests": [
        "PromptBacklogCorpusTests.test_cases_are_independent_raw_inputs_and_expectations_are_not_model_results"
      ],
      "limit": "Selection and external-action fidelity require an approved model-mediated check; corpus/static checks do not prove them."
    },
    {
      "id": "C-coordination",
      "requirement": "Generation, exact wire, strict validation, enrichment, accepted replay, downstream and logical identity/version/hash mapping",
      "disposition": "retained",
      "references": [
        "develop/prompt.md"
      ],
      "worked": "develop/prompt-worked.md",
      "tests": [
        "PromptContractTests.test_wire_rejects_forgery_coercion_duplicates_and_invalid_evidence",
        "PromptContractTests.test_final_validator_rejects_invalid_shape_metadata_and_time_meaning",
        "PromptContractTests.test_every_model_visible_surface_changes_hash_and_registered_identity",
        "PromptContractTests.test_uncertain_empty_evidence_survives_accepted_replay_and_display"
      ]
    },
    {
      "id": "C-source-ownership",
      "requirement": "Application-owned canonical identities and authoritative notice/receipt times remain distinct from occurrence and follow each explicit profile.",
      "disposition": "retained",
      "references": [
        "develop/prompt.md"
      ],
      "worked": "develop/prompt-worked.md",
      "tests": [
        "PromptContractTests.test_reference_identity_timestamp_enrichment_and_consumers",
        "PromptContractTests.test_canonical_identity_is_application_supplied_and_strict",
        "PromptContractTests.test_missing_authoritative_times_never_fall_back"
      ]
    },
    {
      "id": "C-accepted-replay",
      "requirement": "Failed output, repair instructions and validation errors never become accepted replay",
      "disposition": "retained",
      "references": [
        "develop/prompt.md"
      ],
      "worked": "develop/prompt-worked.md",
      "tests": [
        "PromptContractTests.test_heldout_freight_filters_failures_repairs_wrong_runs_and_steps",
        "PromptContractTests.test_replay_rejects_malformed_accepted_output_instead_of_downgrading"
      ]
    },
    {
      "id": "C-transfer",
      "requirement": "independent document-issued versus processing timestamps; domain fields not universal defaults",
      "disposition": "generalized",
      "references": [
        "develop/prompt.md"
      ],
      "worked": "develop/prompt-worked.md",
      "tests": [
        "PromptContractTests.test_equipment_issued_and_processing_times_are_separate_without_domain_fields",
        "PromptContractTests.test_heldout_museum_source_exposes_baseline_bug_and_revised_mapping"
      ]
    },
    {
      "id": "D-authority",
      "requirement": "Complete multi-requirement/item register with current, superseded, conflicting and historical-proposal authority",
      "disposition": "retained",
      "references": [
        "develop/backlog.md"
      ],
      "worked": "develop/backlog-worked.md",
      "tests": [
        "BacklogContractTests.test_authority_inventory_excludes_superseded_duplicates_and_retains_conflicts"
      ],
      "limit": "Business authority is an explicit input to the deterministic fixture, not inferred by code or independently judged by a model."
    },
    {
      "id": "D-roles-baseline",
      "requirement": "Primary delivery, support and validation; Done shared engine is baseline, not user-facing increment completion",
      "disposition": "retained",
      "references": [
        "develop/backlog.md"
      ],
      "worked": "develop/backlog-worked.md",
      "tests": [
        "BacklogContractTests.test_equipment_warehouse_source_proves_baseline_and_only_partial_increment",
        "BacklogContractTests.test_heldout_campus_source_executes_shared_engine_and_partial_delivery",
        "BacklogContractTests.test_heldout_campus_complete_register_matches_roles_priorities_and_gaps"
      ]
    },
    {
      "id": "D-unknown-pagination",
      "requirement": "Partial/gaps/unknown, complete versus incomplete pages, absence elsewhere unknown",
      "disposition": "retained",
      "references": [
        "develop/backlog.md"
      ],
      "worked": "develop/backlog-worked.md",
      "tests": [
        "BacklogContractTests.test_incomplete_pages_change_unseen_owners_to_unknown_not_gaps",
        "BacklogContractTests.test_page_chain_rejects_skips_duplicates_and_rows_after_terminal",
        "BacklogContractTests.test_heldout_course_source_and_incomplete_register_preserve_unknowns"
      ]
    },
    {
      "id": "D-owner-priority",
      "requirement": "Prefer existing semantic owner, retain exact source ranks separately from tracker priority and state",
      "disposition": "retained",
      "references": [
        "develop/backlog.md"
      ],
      "worked": "develop/backlog-worked.md",
      "tests": [
        "BacklogContractTests.test_heldout_campus_complete_register_matches_roles_priorities_and_gaps",
        "BacklogContractTests.test_overlapping_primary_owners_require_resolution_not_arbitrary_selection",
        "BacklogContractTests.test_heldout_course_source_and_incomplete_register_preserve_unknowns"
      ]
    },
    {
      "id": "D-no-mutation",
      "requirement": "Historical proposals do not authorize mutations; completed baseline history retained",
      "disposition": "retained",
      "references": [
        "develop/backlog.md"
      ],
      "worked": "develop/backlog-worked.md",
      "tests": [
        "BacklogContractTests.test_reconciliation_does_not_mutate_inputs_or_turn_done_support_into_delivery"
      ],
      "limit": "Input immutability is exercised locally; external tracker non-mutation/model behavior is not independently evaluated."
    },
    {
      "id": "C-D-project-defaults",
      "requirement": "Do not transplant source-project journal width, domain schemas, custom tracker IDs or deployment instructions",
      "disposition": "excluded_as_portable_defaults",
      "references": [
        "develop/prompt.md",
        "develop/backlog.md"
      ],
      "worked": "develop/prompt-worked.md",
      "tests": [
        "PromptContractTests.test_equipment_issued_and_processing_times_are_separate_without_domain_fields"
      ],
      "limit": "The actual target's instructions determine schema, identities, dependencies and permitted effects; examples do not set target defaults."
    }
  ],
  "cases": {
    "prompt-museum-issued-processing": [
      "PromptContractTests.test_heldout_museum_source_exposes_baseline_bug_and_revised_mapping"
    ],
    "prompt-freight-accepted-replay": [
      "PromptContractTests.test_heldout_freight_filters_failures_repairs_wrong_runs_and_steps"
    ],
    "backlog-campus-complete-coverage": [
      "BacklogContractTests.test_heldout_campus_source_executes_shared_engine_and_partial_delivery",
      "BacklogContractTests.test_heldout_campus_complete_register_matches_roles_priorities_and_gaps",
      "BacklogContractTests.test_incomplete_pages_change_unseen_owners_to_unknown_not_gaps"
    ],
    "backlog-course-incomplete-inventory": [
      "BacklogContractTests.test_heldout_course_source_and_incomplete_register_preserve_unknowns"
    ]
  }
}
